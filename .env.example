# Ambiente — injetado pelo EAS Build em build time (não precisa de EXPO_PUBLIC_)
APP_ENV=development

# API Backend — EXPO_PUBLIC_ para expor ao cliente
# Android Emulator: use http://10.0.2.2:3000/api/v1 (alias para o localhost do host)
# iOS Simulator: http://localhost:3000/api/v1 funciona normalmente
# Dispositivo físico: use o IP da máquina host na rede local (ex: http://192.168.x.x:3000/api/v1)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# WebSocket (Socket.io, NotificationsGateway) — opcional, derivado de
# EXPO_PUBLIC_API_BASE_URL (strip do sufixo /api/v1) se não definido.
# Só precisa ser setado se o host do WebSocket for diferente do host da API.
# EXPO_PUBLIC_WS_BASE_URL=http://localhost:3000

# Keycloak
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8080
EXPO_PUBLIC_KEYCLOAK_REALM=soundmeet
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=soundmeet-mobile
