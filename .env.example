# Ambiente — injetado pelo EAS Build (eas.json). PRECISA do prefixo EXPO_PUBLIC_:
# só essas chaves o babel inlina no bundle; sem o prefixo a variável é
# undefined no aparelho e todo build se declara "development" (SM-017).
EXPO_PUBLIC_APP_ENV=development

# API Backend — EXPO_PUBLIC_ para expor ao cliente
#
# ⚠️ http:// só é aceito com EXPO_PUBLIC_APP_ENV=development. Em preview e
# production o app RECUSA subir com esquema inseguro (env.ts valida no boot):
# `POST /auth/login` manda senha em claro e o Socket.io manda o JWT no
# handshake. Em production o host ainda precisa estar em
# PRODUCTION_HOST_ALLOWLIST (src/shared/services/config/env.ts).
#
# Android Emulator: use http://10.0.2.2:3000/api/v1 (alias para o localhost do host)
# iOS Simulator: http://localhost:3000/api/v1 funciona normalmente
# Dispositivo físico: use o IP da máquina host na rede local (ex: http://192.168.x.x:3000/api/v1)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# WebSocket (Socket.io, NotificationsGateway) — opcional, derivado de
# EXPO_PUBLIC_API_BASE_URL (strip do sufixo /api/v1) se não definido.
# Só precisa ser setado se o host do WebSocket for diferente do host da API.
# EXPO_PUBLIC_WS_BASE_URL=http://localhost:3000

# Keycloak
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8080
EXPO_PUBLIC_KEYCLOAK_REALM=soundmeet
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=soundmeet-mobile

# Monitoramento (Sentry) — DSN vazio = SDK inerte, não bloqueia boot.
# Criar projeto React Native em sentry.io e colar o DSN aqui.
EXPO_PUBLIC_SENTRY_DSN=
