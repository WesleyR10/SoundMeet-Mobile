# Ambiente — injetado pelo EAS Build em build time (não precisa de EXPO_PUBLIC_)
APP_ENV=development

# API Backend — EXPO_PUBLIC_ para expor ao cliente
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Keycloak
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8080
EXPO_PUBLIC_KEYCLOAK_REALM=soundmeet
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=soundmeet-mobile
