{
  "expo": {
    "name": "SoundMeet",
    "slug": "soundmeet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/icon-1024.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0C14",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.soundmeet.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Necessário para escanear QR codes de músicos",
        "NSMicrophoneUsageDescription": "Necessário para o afinador cromático"
      }
    },
    "android": {
      "package": "com.soundmeet.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/adaptive-foreground-1024.png",
        "backgroundColor": "#0C0C14"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/logo/icon-1024.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Necessário para escanear QR codes de músicos"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Necessário para escolher sua foto de perfil"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo/adaptive-foreground-1024.png",
          "color": "#00E0B8"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/logo_verde-removebg-preview.png",
          "resizeMode": "contain",
          "backgroundColor": "#0C0C14"
        }
      ],
      "expo-video",
      "expo-asset",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Precisamos salvar o QR Code na sua galeria.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Precisamos do microfone para o afinador cromático ouvir seu instrumento",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização para mostrar shows e estabelecimentos perto de você."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "afdfdfb9-9122-4c02-a3bd-cd34ce15d10e"
      }
    },
    "scheme": "soundmeet"
  }
}
