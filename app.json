{
  "expo": {
    "name": "SoundMeet",
    "slug": "soundmeet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/logo-verde.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0C14",
    "splash": {
      "image": "./assets/logo/logo-verde.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0C14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.soundmeet.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Necessário para escanear QR codes de músicos",
        "NSMicrophoneUsageDescription": "Necessário para o afinador cromático"
      }
    },
    "android": {
      "package": "com.soundmeet.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/logo-verde.png",
        "backgroundColor": "#0C0C14"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/logo/logo-verde.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        { "cameraPermission": "Necessário para escanear QR codes de músicos" }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo/logo-verde.png",
          "color": "#00E0B8"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "afdfdfb9-9122-4c02-a3bd-cd34ce15d10e"
      }
    },
    "scheme": "soundmeet"
  }
}
